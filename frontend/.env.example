# Leave blank to use same-origin /api (the Vite proxy in dev, nginx in prod).
VITE_API_BASE_URL=

# Where the dev-server proxy forwards /api. Use http://api:8000 inside Compose.
VITE_API_PROXY_TARGET=http://localhost:8000

# Docker bind mounts on Windows don't emit inotify events; set true if HMR is dead.
VITE_USE_POLLING=false
