# Normalize to LF in the repo; let Git decide the working-copy ending.
* text=auto

# These are read by Linux inside containers - CRLF breaks them outright.
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
docker/**/* text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary
*.png binary
*.jpg binary
*.pdf binary
*.wav binary
*.mp3 binary
