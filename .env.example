# ---------------------------------------------------------------------------
# PARALLAX environment. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

PARALLAX_ENV=local
PARALLAX_DEBUG=true
PARALLAX_LOG_LEVEL=INFO

# --- API -------------------------------------------------------------------
PARALLAX_API_HOST=0.0.0.0
PARALLAX_API_PORT=8000
PARALLAX_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=5173
# "dev" = Vite dev server with HMR; "runtime" = static build behind nginx.
FRONTEND_BUILD_TARGET=dev
# Docker bind mounts on Windows don't emit inotify events; leave true there.
VITE_USE_POLLING=true

# --- PostgreSQL ------------------------------------------------------------
# These three are consumed by the postgres container itself.
POSTGRES_USER=parallax
POSTGRES_PASSWORD=parallax
POSTGRES_DB=parallax

# Host is the compose service name when running in Docker, "localhost" otherwise.
PARALLAX_POSTGRES_HOST=postgres
PARALLAX_POSTGRES_PORT=5432
PARALLAX_POSTGRES_USER=parallax
PARALLAX_POSTGRES_PASSWORD=parallax
PARALLAX_POSTGRES_DB=parallax
PARALLAX_POSTGRES_POOL_SIZE=10
PARALLAX_POSTGRES_MAX_OVERFLOW=20
PARALLAX_POSTGRES_ECHO=false

# --- Redis -----------------------------------------------------------------
PARALLAX_REDIS_URL=redis://redis:6379/0

# --- Qdrant ----------------------------------------------------------------
PARALLAX_QDRANT_URL=http://qdrant:6333
PARALLAX_QDRANT_API_KEY=
PARALLAX_QDRANT_COLLECTION=parallax_claims

# --- MinIO -----------------------------------------------------------------
MINIO_ROOT_USER=parallax
MINIO_ROOT_PASSWORD=parallax123
PARALLAX_MINIO_ENDPOINT=minio:9000
PARALLAX_MINIO_ACCESS_KEY=parallax
PARALLAX_MINIO_SECRET_KEY=parallax123
PARALLAX_MINIO_BUCKET=parallax-artifacts
PARALLAX_MINIO_SECURE=false

# --- Embeddings ------------------------------------------------------------
PARALLAX_EMBEDDING_MODEL=BAAI/bge-m3
PARALLAX_EMBEDDING_DIM=1024
PARALLAX_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM (local, OpenAI-compatible) ----------------------------------------
# Works with any server speaking /v1/chat/completions:
#   Ollama      http://localhost:11434/v1   (model e.g. qwen2.5:7b)
#   LM Studio   http://localhost:1234/v1
#   llama.cpp   http://localhost:8080/v1
#   vLLM        http://localhost:8000/v1
# From inside Docker use host.docker.internal instead of localhost.
# The model MUST support tool calling, or the agent cannot use its tools.
PARALLAX_LLM_BASE_URL=http://localhost:11434/v1
PARALLAX_LLM_MODEL=qwen2.5:7b
PARALLAX_LLM_API_KEY=not-needed
PARALLAX_LLM_TEMPERATURE=0.0
PARALLAX_LLM_TIMEOUT_S=120
PARALLAX_AGENT_MAX_ITERATIONS=5

# --- Observability ---------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
